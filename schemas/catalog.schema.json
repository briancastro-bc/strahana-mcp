{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "label": { "type": "string", "minLength": 1 },
    "entities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "synonyms": {
            "default": [],
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "type": {
                  "type": "string",
                  "enum": ["string", "decimal", "integer", "bigint", "date", "timestamp", "boolean"]
                },
                "length": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "precision": { "type": "integer", "minimum": 1, "maximum": 38 },
                "scale": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "key": { "default": false, "type": "boolean" },
                "label": { "type": "string", "minLength": 1 },
                "synonyms": {
                  "default": [],
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["name", "type", "label"],
              "additionalProperties": false
            }
          },
          "joins": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "on": {
                  "type": "object",
                  "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              },
              "required": ["entity", "on"],
              "additionalProperties": false
            }
          },
          "rules": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "required": ["name", "label", "columns"],
        "additionalProperties": false
      }
    }
  },
  "required": ["domain", "version", "label", "entities"],
  "additionalProperties": false
}
